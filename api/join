from http.server import BaseHTTPRequestHandler
from urllib.parse import urlparse, parse_qs
import os

class handler(BaseHTTPRequestHandler):
    def do_GET(self):
        # Get channel id from URL: /api/join?id=tech_updates
        query = parse_qs(urlparse(self.path).query)
        channel_id = query.get('id', [''])[0].strip().upper()

        if not channel_id:
            self._respond(400, b'Missing channel id')
            return

        # Read actual Telegram link from environment variable ONLY
        # Link is NEVER sent to the browser — server redirects directly
        link = os.environ.get(f'CHANNEL_LINK_{channel_id}', '')

        if not link or not link.startswith('https://t.me/'):
            self._respond(404, b'Channel not found')
            return

        # Server-side redirect — user goes to Telegram, link stays hidden
        self.send_response(302)
        self.send_header('Location', link)
        self.end_headers()

    def _respond(self, code, body):
        self.send_response(code)
        self.send_header('Content-Type', 'text/plain')
        self.end_headers()
        self.wfile.write(body)
